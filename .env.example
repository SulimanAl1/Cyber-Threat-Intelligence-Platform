# Global Cyber Threat Intelligence Platform - Environment Template
# No API keys are required for standard operation.
# Optional API keys can be supplied for enhanced enrichment rate limits in GitHub Actions secrets.

# Optional: NVD API Key (increases rate limit from 5 to 50 requests per 30s)
# NVD_API_KEY=

# Optional: ThreatFox Auth-Key (if required for elevated abuse.ch quotas)
# ABUSE_CH_API_KEY=

# Base URL override (defaults to /Cyber-Security-Dashboard/ in production build)
VITE_BASE_URL=/Cyber-Security-Dashboard/
